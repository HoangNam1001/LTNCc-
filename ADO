#region 1. TẦNG ENTITY (MODEL)
namespace QuanLySinhVien.Data.Entity
{
    public class LopHoc
    {
        public string MaLop { get; set; }
        public string TenLop { get; set; }
    }

    public class SinhVien
    {
        [Required(ErrorMessage = "Mã sinh viên không được để trống")]
        public string MaSV { get; set; }

        [Required(ErrorMessage = "Họ tên không được để trống")]
        public string HoTen { get; set; }

        public string NgaySinh { get; set; }
        public string GioiTinh { get; set; }

        [EmailAddress(ErrorMessage = "Email không đúng định dạng")]
        public string Email { get; set; }

        [Phone(ErrorMessage = "Số điện thoại không hợp lệ")]
        public string SoDienThoai { get; set; }

        public string MaLop { get; set; }

        [Range(0, 10, ErrorMessage = "Điểm phải từ 0 đến 10")]
        public double Diem { get; set; }

        // Phương thức kiểm tra Validation cho Entity
        public List<ValidationResult> IsInValid()
        {
            var results = new List<ValidationResult>();
            var context = new ValidationContext(this, null, null);
            Validator.TryValidateObject(this, context, results, true);
            return results;
        }
    }
}
#endregion

#region 2. TẦNG DATA ACCESS LAYER (DAL)
namespace QuanLySinhVien.Data.DAL
{
    using QuanLySinhVien.Data.Entity;

    public class DataHelper
    {
        private readonly string connectionString = @"Server=LAPTOP-6SN65NCS\HUECTMDB; Database=QLSV; Integrated Security=True; TrustServerCertificate=True";

        public SqlConnection GetConnection()
        {
            return new SqlConnection(connectionString);
        }

        public DataTable GetDataTable(string sql, SqlParameter[] parameters = null)
        {
            using (SqlConnection con = GetConnection())
            {
                using (SqlCommand cmd = new SqlCommand(sql, con))
                {
                    if (parameters != null) cmd.Parameters.AddRange(parameters);
                    using (SqlDataAdapter da = new SqlDataAdapter(cmd))
                    {
                        DataTable dt = new DataTable();
                        da.Fill(dt);
                        return dt;
                    }
                }
            }
        }

        public int ExecuteNonQuery(string sql, SqlParameter[] parameters = null)
        {
            using (SqlConnection con = GetConnection())
            {
                con.Open();
                using (SqlCommand cmd = new SqlCommand(sql, con))
                {
                    if (parameters != null) cmd.Parameters.AddRange(parameters);
                    return cmd.ExecuteNonQuery();
                }
            }
        }
    }

    public class LopHocDAO
    {
        private readonly DataHelper dataHelper = new DataHelper();

        public List<LopHoc> GetAllLopHoc()
        {
            try
            {
                List<LopHoc> list = new List<LopHoc>();
                DataTable dt = dataHelper.GetDataTable("SELECT * FROM LopHoc");

                foreach (DataRow dr in dt.Rows)
                {
                    list.Add(new LopHoc
                    {
                        MaLop = dr["MaLop"].ToString(),
                        TenLop = dr.Table.Columns.Contains("TenLop") ? dr["TenLop"].ToString() : dr["MaLop"].ToString()
                    });
                }
                return list;
            }
            catch (Exception ex)
            {
                throw new Exception("Lỗi CSDL [LopHocDAO]: " + ex.Message, ex);
            }
        }
    }

    public class SinhVienDAO
    {
        private readonly DataHelper dataHelper = new DataHelper();

        public List<SinhVien> GetAllSinhVien()
        {
            try
            {
                List<SinhVien> list = new List<SinhVien>();
                DataTable dt = dataHelper.GetDataTable("SELECT * FROM SinhVien");
                foreach (DataRow dr in dt.Rows) list.Add(MapRowToSinhVien(dr));
                return list;
            }
            catch (Exception ex)
            {
                throw new Exception("Lỗi CSDL [SinhVienDAO - GetAll]: " + ex.Message, ex);
            }
        }

        public List<SinhVien> GetSinhViensByMaLop(string maLop)
        {
            try
            {
                List<SinhVien> list = new List<SinhVien>();
                string sql = "SELECT * FROM SinhVien WHERE MaLop = @MaLop";
                SqlParameter[] parameters = { new SqlParameter("@MaLop", maLop) };

                DataTable dt = dataHelper.GetDataTable(sql, parameters);
                foreach (DataRow dr in dt.Rows) list.Add(MapRowToSinhVien(dr));
                return list;
            }
            catch (Exception ex)
            {
                throw new Exception("Lỗi CSDL [SinhVienDAO - GetByMaLop]: " + ex.Message, ex);
            }
        }

        public SinhVien GetSinhVienById(string maSV)
        {
            try
            {
                string sql = "SELECT * FROM SinhVien WHERE MaSV = @MaSV";
                SqlParameter[] parameters = { new SqlParameter("@MaSV", maSV) };

                DataTable dt = dataHelper.GetDataTable(sql, parameters);
                if (dt.Rows.Count > 0) return MapRowToSinhVien(dt.Rows[0]);
                return null;
            }
            catch (Exception ex)
            {
                throw new Exception("Lỗi CSDL [SinhVienDAO - GetById]: " + ex.Message, ex);
            }
        }

        public void AddSinhVien(SinhVien sv)
        {
            try
            {
                string sql = @"INSERT INTO SinhVien (MaSV, MaLop, HoTen, GioiTinh, NgaySinh, Diem, SoDienThoai, Email) 
                               VALUES (@MaSV, @MaLop, @HoTen, @GioiTinh, @NgaySinh, @Diem, @SoDienThoai, @Email)";

                SqlParameter[] parameters = {
                    new SqlParameter("@MaSV", sv.MaSV),
                    new SqlParameter("@MaLop", sv.MaLop ?? (object)DBNull.Value),
                    new SqlParameter("@HoTen", sv.HoTen),
                    new SqlParameter("@GioiTinh", sv.GioiTinh),
                    new SqlParameter("@NgaySinh", DateTime.Parse(sv.NgaySinh)),
                    new SqlParameter("@Diem", sv.Diem),
                    new SqlParameter("@SoDienThoai", sv.SoDienThoai ?? (object)DBNull.Value),
                    new SqlParameter("@Email", sv.Email ?? (object)DBNull.Value)
                };

                dataHelper.ExecuteNonQuery(sql, parameters);
            }
            catch (Exception ex)
            {
                throw new Exception("Lỗi CSDL [SinhVienDAO - Add]: " + ex.Message, ex);
            }
        }

        public void UpdateSinhVien(SinhVien sv)
        {
            try
            {
                string sql = @"UPDATE SinhVien 
                               SET HoTen = @HoTen, MaLop = @MaLop, GioiTinh = @GioiTinh, 
                                   NgaySinh = @NgaySinh, Diem = @Diem, 
                                   SoDienThoai = @SoDienThoai, Email = @Email 
                               WHERE MaSV = @MaSV";

                SqlParameter[] parameters = {
                    new SqlParameter("@MaSV", sv.MaSV),
                    new SqlParameter("@MaLop", sv.MaLop ?? (object)DBNull.Value),
                    new SqlParameter("@HoTen", sv.HoTen),
                    new SqlParameter("@GioiTinh", sv.GioiTinh),
                    new SqlParameter("@NgaySinh", DateTime.Parse(sv.NgaySinh)),
                    new SqlParameter("@Diem", sv.Diem),
                    new SqlParameter("@SoDienThoai", sv.SoDienThoai ?? (object)DBNull.Value),
                    new SqlParameter("@Email", sv.Email ?? (object)DBNull.Value)
                };

                dataHelper.ExecuteNonQuery(sql, parameters);
            }
            catch (Exception ex)
            {
                throw new Exception("Lỗi CSDL [SinhVienDAO - Update]: " + ex.Message, ex);
            }
        }

        public void DeleteSinhVien(string maSV)
        {
            try
            {
                string sql = "DELETE FROM SinhVien WHERE MaSV = @MaSV";
                SqlParameter[] parameters = { new SqlParameter("@MaSV", maSV) };
                dataHelper.ExecuteNonQuery(sql, parameters);
            }
            catch (Exception ex)
            {
                throw new Exception("Lỗi CSDL [SinhVienDAO - Delete]: " + ex.Message, ex);
            }
        }

        private SinhVien MapRowToSinhVien(DataRow dr)
        {
            return new SinhVien
            {
                MaSV = dr["MaSV"].ToString(),
                HoTen = dr["HoTen"].ToString(),
                GioiTinh = dr["GioiTinh"].ToString(),
                NgaySinh = Convert.ToDateTime(dr["NgaySinh"]).ToString("yyyy-MM-dd"),
                SoDienThoai = dr["SoDienThoai"].ToString(),
                MaLop = dr["MaLop"].ToString(),
                Diem = double.Parse(dr["Diem"].ToString()),
                Email = dr["Email"].ToString()
            };
        }
    }
}
#endregion

#region 3. TẦNG BUSINESS LOGIC LAYER (BLL)
namespace QuanLySinhVien.BLL
{
    using QuanLySinhVien.Data.DAL;
    using QuanLySinhVien.Data.Entity;

    public class LopHocBUS
    {
        private readonly LopHocDAO lopHocDAO = new LopHocDAO();

        public List<LopHoc> GetAllLopHoc()
        {
            try
            {
                return lopHocDAO.GetAllLopHoc();
            }
            catch (Exception ex)
            {
                throw new Exception("Nghiệp vụ - Lỗi tải danh sách lớp: " + ex.Message, ex);
            }
        }
    }

    public class SinhVienBUS
    {
        private readonly SinhVienDAO sinhVienDAO = new SinhVienDAO();

        public List<SinhVien> GetAllSinhVien()
        {
            try
            {
                return sinhVienDAO.GetAllSinhVien();
            }
            catch (Exception ex)
            {
                throw new Exception("Nghiệp vụ - Lỗi lấy danh sách sinh viên: " + ex.Message, ex);
            }
        }

        public List<SinhVien> GetSinhViensByMaLop(string maLop)
        {
            try
            {
                if (string.IsNullOrEmpty(maLop)) return new List<SinhVien>();
                return sinhVienDAO.GetSinhViensByMaLop(maLop);
            }
            catch (Exception ex)
            {
                throw new Exception("Nghiệp vụ - Lỗi lọc sinh viên theo lớp: " + ex.Message, ex);
            }
        }

        public SinhVien GetSinhVienById(string maSV)
        {
            try
            {
                if (string.IsNullOrWhiteSpace(maSV)) return null;
                return sinhVienDAO.GetSinhVienById(maSV);
            }
            catch (Exception ex)
            {
                throw new Exception("Nghiệp vụ - Lỗi tìm sinh viên theo mã: " + ex.Message, ex);
            }
        }

        public void AddSinhVien(SinhVien sv)
        {
            try
            {
                if (sinhVienDAO.GetSinhVienById(sv.MaSV) != null)
                {
                    throw new Exception("Mã sinh viên đã tồn tại trong CSDL.");
                }
                sinhVienDAO.AddSinhVien(sv);
            }
            catch (Exception ex)
            {
                throw new Exception("Nghiệp vụ - Thêm sinh viên thất bại: " + ex.Message, ex);
            }
        }

        public void UpdateSinhVien(SinhVien sv)
        {
            try
            {
                if (sinhVienDAO.GetSinhVienById(sv.MaSV) == null)
                {
                    throw new Exception("Không tìm thấy sinh viên để cập nhật.");
                }
                sinhVienDAO.UpdateSinhVien(sv);
            }
            catch (Exception ex)
            {
                throw new Exception("Nghiệp vụ - Cập nhật sinh viên thất bại: " + ex.Message, ex);
            }
        }

        public void DeleteSinhVien(string maSV)
        {
            try
            {
                if (sinhVienDAO.GetSinhVienById(maSV) == null)
                {
                    throw new Exception("Mã sinh viên không tồn tại.");
                }
                sinhVienDAO.DeleteSinhVien(maSV);
            }
            catch (Exception ex)
            {
                throw new Exception("Nghiệp vụ - Xóa sinh viên thất bại: " + ex.Message, ex);
            }
        }
    }
}
