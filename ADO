#region 4. TẦNG PRESENTATION LAYER (WINFORMS GUI)
namespace QuanLySinhVien
{
    using QuanLySinhVien.BLL;
    using QuanLySinhVien.Data.Entity;

    public partial class FrmQuanLySinhVien : Form
    {
        private readonly SinhVienBUS svBus = new SinhVienBUS();
        private readonly LopHocBUS lopBus = new LopHocBUS();

        public FrmQuanLySinhVien()
        {
            InitializeComponent();
        }

        private void FrmQuanLySinhVien_Load(object sender, EventArgs e)
        {
            LoadComboboxLop();
        }

        // Lấy danh sách lớp lên Combobox
        private void LoadComboboxLop()
        {
            try
            {
                List<LopHoc> listLop = lopBus.GetAllLopHoc();
                cboLop.DataSource = listLop;
                cboLop.DisplayMember = "TenLop";
                cboLop.ValueMember = "MaLop";
            }
            catch (Exception ex)
            {
                MessageBox.Show(ex.Message, "Lỗi Hệ Thống", MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }

        // Đổi lớp hiển thị danh sách Sinh viên tương ứng
        private void cboLop_SelectedIndexChanged(object sender, EventArgs e)
        {
            if (cboLop.SelectedValue == null) return;

            try
            {
                string maLop = cboLop.SelectedValue.ToString();
                List<SinhVien> listSV = svBus.GetSinhViensByMaLop(maLop);
                dgvSinhVien.DataSource = listSV;
            }
            catch (Exception ex)
            {
                MessageBox.Show(ex.Message, "Lỗi Tải Dữ Liệu", MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }

        // Nhập Mã SV -> Tự động load hoặc Xóa trống khi rời khỏi ô txtMaSV (Leave)
        private void txtMaSV_Leave(object sender, EventArgs e)
        {
            string maSV = txtMaSV.Text.Trim();
            if (string.IsNullOrEmpty(maSV))
            {
                ClearInputs();
                return;
            }

            try
            {
                SinhVien sv = svBus.GetSinhVienById(maSV);
                if (sv != null)
                {
                    txtHoTen.Text = sv.HoTen;
                    dtpNgaySinh.Value = DateTime.TryParse(sv.NgaySinh, out DateTime dt) ? dt : DateTime.Now;
                    rdoNam.Checked = sv.GioiTinh.Equals("Nam", StringComparison.OrdinalIgnoreCase);
                    rdoNu.Checked = !rdoNam.Checked;
                    txtEmail.Text = sv.Email;
                    txtDienThoai.Text = sv.SoDienThoai;
                    cboLop.SelectedValue = sv.MaLop;
                    numDiem.Value = (decimal)sv.Diem;
                }
                else
                {
                    ClearInputsExceptMaSV();
                }
            }
            catch (Exception ex)
            {
                MessageBox.Show(ex.Message, "Lỗi Tìm Kiếm", MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }

        // Xử lý Thêm Sinh Viên với Validation và ErrorProvider
        private void butThem_Click(object sender, EventArgs e)
        {
            ClearAllErrorProviders();

            SinhVien sv = new SinhVien
            {
                MaSV = txtMaSV.Text.Trim(),
                HoTen = txtHoTen.Text.Trim(),
                NgaySinh = dtpNgaySinh.Value.ToString("yyyy-MM-dd"),
                GioiTinh = rdoNam.Checked ? "Nam" : "Nữ",
                Email = txtEmail.Text.Trim(),
                SoDienThoai = txtDienThoai.Text.Trim(),
                MaLop = cboLop.SelectedValue?.ToString(),
                Diem = (double)numDiem.Value
            };

            List<ValidationResult> errors = sv.IsInValid();

            if (errors.Count > 0)
            {
                SetErrorMessages(errors);
                return;
            }

            try
            {
                svBus.AddSinhVien(sv);
                MessageBox.Show("Thêm sinh viên thành công!", "Thông báo", MessageBoxButtons.OK, MessageBoxIcon.Information);
                cboLop_SelectedIndexChanged(null, null); // Refresh grid
            }
            catch (Exception ex)
            {
                MessageBox.Show(ex.Message, "Lỗi Thực Thư", MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }

        // Báo lỗi ErrorProvider trên từng Control
        private void SetErrorMessages(List<ValidationResult> errors)
        {
            foreach (var error in errors)
            {
                string fieldName = error.MemberNames.FirstOrDefault();
                switch (fieldName)
                {
                    case "MaSV":
                        errPMaSV.SetError(txtMaSV, error.ErrorMessage);
                        txtMaSV.Focus();
                        break;
                    case "HoTen":
                        erpHoten.SetError(txtHoTen, error.ErrorMessage);
                        txtHoTen.Focus();
                        break;
                    case "Email":
                        erpEmail.SetError(txtEmail, error.ErrorMessage);
                        txtEmail.Focus();
                        break;
                    case "SoDienThoai":
                        erpDienThoai.SetError(txtDienThoai, error.ErrorMessage);
                        txtDienThoai.Focus();
                        break;
                    default:
                        MessageBox.Show(error.ErrorMessage, "Lỗi Dữ Liệu", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                        break;
                }
            }
        }

        private void ClearAllErrorProviders()
        {
            errPMaSV.Clear();
            erpHoten.Clear();
            erpEmail.Clear();
            erpDienThoai.Clear();
        }

        private void ClearInputsExceptMaSV()
        {
            txtHoTen.Clear();
            txtEmail.Clear();
            txtDienThoai.Clear();
            numDiem.Value = 0;
            dtpNgaySinh.Value = DateTime.Now;
        }

        private void ClearInputs()
        {
            txtMaSV.Clear();
            ClearInputsExceptMaSV();
        }
    }
}
#endregion
