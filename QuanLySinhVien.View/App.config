<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <connectionStrings>
    <!-- Sửa lại Server cho đúng máy chủ SQL Server của bạn.
         DataHelper sẽ tự đọc chuỗi kết nối này theo tên "QLSV". -->
    <add name="QLSV"
         connectionString="Server=LAPTOP-6SN65NCS\HUECTMDB;Database=QLSV;Integrated Security=True;TrustServerCertificate=True"
         providerName="Microsoft.Data.SqlClient" />
  </connectionStrings>
</configuration>
