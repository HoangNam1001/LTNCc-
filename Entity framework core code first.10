using System;
using System.ComponentModel.DataAnnotations;
using System.ComponentModel.DataAnnotations.Schema;
using Microsoft.EntityFrameworkCore;

namespace QuanLyThuVien
{
    // ==========================================
    // 1. CÁC LỚP THỰC THỂ (ENTITY CLASSES)
    // ==========================================

    [Table("DocGia")]
    public class DocGia
    {
        [Key]
        [DatabaseGenerated(DatabaseGeneratedOption.Identity)]
        public int MaDocGia { get; set; }

        [Required]
        [StringLength(100)]
        public string HoTen { get; set; } = string.Empty;

        [Required]
        [StringLength(15)]
        public string SoDienThoai { get; set; } = string.Empty;

        public DateTime NgayDangKy { get; set; } = DateTime.Now;

        // Navigation property (Quan hệ 1 - 1 với ThieuNhi)
        public virtual ThieuNhi? ThongTinThieuNhi { get; set; }
    }

    [Table("ThieuNhi")]
    public class ThieuNhi
    {
        [Key, ForeignKey("DocGia")]
        public int MaDocGia { get; set; }

        [Required]
        [StringLength(100)]
        public string HoTenNguoiGiamHo { get; set; } = string.Empty;

        [Required]
        [StringLength(15)]
        public string SoDienThoaiGiamHo { get; set; } = string.Empty;

        public int Tuoi { get; set; }

        // Navigation property
        public virtual DocGia? DocGia { get; set; }
    }

    // ==========================================
    // 2. LỚP CONTEXT (QLTVDBContext)
    // ==========================================

    public class QLTVDBContext : DbContext
    {
        public QLTVDBContext()
        {
        }

        public QLTVDBContext(DbContextOptions<QLTVDBContext> options) : base(options)
        {
        }

        public DbSet<DocGia> DocGias { get; set; } = null!;
        public DbSet<ThieuNhi> ThieuNhis { get; set; } = null!;

        protected override void OnConfiguring(DbContextOptionsBuilder optionsBuilder)
        {
            if (!optionsBuilder.IsConfigured)
            {
                // Thay đổi chuỗi kết nối SQL Server phù hợp với máy của bạn
                optionsBuilder.UseSqlServer("Server=.;Database=QuanLyThuVienDB;Trusted_Connection=True;TrustServerCertificate=True;");
            }
        }

        protected override void OnModelCreating(ModelBuilder modelBuilder)
        {
            base.OnModelCreating(modelBuilder);

            // Cấu hình quan hệ 1 - 1 giữa DocGia và ThieuNhi
            modelBuilder.Entity<DocGia>()
                .HasOne(d => d.ThongTinThieuNhi)
                .WithOne(t => t.DocGia)
                .HasForeignKey<ThieuNhi>(t => t.MaDocGia);
        }
    }

    // ==========================================
    // 3. CHƯƠNG TRÌNH CHÍNH (PROGRAM)
    // ==========================================

    public class Program
    {
        public static void Main(string[] args)
        {
            Console.WriteLine("Entity Framework Core Code First Initialized.");
        }
    }
}
